# Crawl4AI 独立容器
# 提供 JS 渲染爬取能力，避免主容器镜像膨胀
FROM python:3.10-slim

# 安装系统依赖（Chromium 需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# 设置 Chromium 环境变量
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMIUM_PATH=/usr/bin/chromium
ENV DISPLAY=:99

WORKDIR /app

# 安装 Python 依赖
COPY docker/requirements-crawl4ai.txt .
RUN pip install --no-cache-dir -r requirements-crawl4ai.txt

# 复制爬取服务代码
COPY odap/biz/data/web_crawl/ /app/odap/biz/data/web_crawl/

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import crawl4ai; print('ok')" || exit 1

# 暴露 Crawl4AI API 端口
EXPOSE 8020

CMD ["python", "-m", "crawl4ai.cli", "serve", "--host", "0.0.0.0", "--port", "8020"]
