# Browser-Use MCP Server 独立容器
# AI 驱动浏览器自动化，需要 Chromium + browser-use + LangChain
FROM python:3.10-slim

# 安装系统依赖（Chromium + 中文字体）
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    fonts-liberation \
    fonts-wqy-zenhei \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMIUM_PATH=/usr/bin/chromium
ENV DISPLAY=:99

WORKDIR /app

# 安装 Python 依赖
RUN pip install --no-cache-dir \
    browser-use>=0.2.0 \
    langchain-openai>=0.3.0 \
    fastapi>=0.115.0 \
    uvicorn>=0.31.0 \
    httpx>=0.27.0 \
    pydantic>=2.0.0

# 复制 MCP Server 代码
COPY odap/biz/integration/mcp_adapter/browser_tool_server.py /app/

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import browser_use; print('ok')" || exit 1

EXPOSE 8030

CMD ["python", "-m", "uvicorn", "browser_tool_server:app", "--host", "0.0.0.0", "--port", "8030"]
