# Large Language Model Configuration
# OpenAI API Key (required for graphiti-core)
# 请在这里填入您的 API Key；提交仓库前务必移除真实值，防止密钥泄漏
# 获取地址：NVIDIA https://build.nvidia.com/models  · SiliconFlow https://cloud.siliconflow.cn
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# OPENAI_API_BASE=https://api.siliconflow.cn/v1/chat/completions
OPENAI_MODEL=deepseek-ai/deepseek-v4-flash
# OPENAI_MODEL=deepseek-ai/deepseek-v4-pro
# OPENAI_MODEL=Pro/MiniMaxAI/MiniMax-M2.5
# Embedder model — NVIDIA API supports baai/bge-m3 (multilingual, 8192 tokens, 1024-dim)
EMBEDDER_MODEL=baai/bge-m3
# Embedder provider: auto (try API, fallback to local) | api | local
# NVIDIA API does not support /embeddings endpoint — use local HuggingFace
EMBEDDER_PROVIDER=local
EMBEDDER_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace mirror (for downloading local embedder models in CN network)
HF_ENDPOINT=https://hf-mirror.com

# Admin 初始密码 (dev/test 专用；生产必须 ≥16 字符强随机，不可与示例一致)
# 后端启动时若未设置 ODAP_ADMIN_PASSWORD，会生成随机密码写入 log warning
ODAP_ADMIN_PASSWORD=your_admin_initial_password_here

# Search API Configuration
# Tavily API Key (required for advanced news ingestion)
# 获取地址：https://tavily.com  —  提交前请留空
TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DDG_API_URL=your_ddg_api_url_here
# DDG_API_URL=http://localhost:8080
# SerpAPI Key (optional, for Google 搜索增强)
SERPAPI_KEY=your_serpapi_key_here

# Neo4j Configuration
# 容器环境：bolt://graphiti-neo4j:7687   本地开发：bolt://localhost:7687
NEO4J_URI=bolt://graphiti-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# OPA Configuration
OPA_URL=http://graphiti-policy-service:8181

# Redis Configuration
REDIS_URL=redis://graphiti-cache:6379

# Data Persistence Directory
DATA_DIR=/app/data

# CORS Configuration
# 前端 dev (Vite) 端口 5173 / 后端 8000 / 前端 prod (nginx) 8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080

# Security Configuration
# JWT Secret for API authentication
# 生产环境必须 ≥32 字符的强随机密钥；提交前请替换为您自己的密钥
# 生成方式：`python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET=your_jwt_secret_here
# JWT_SECRET=please-generate-a-64-char-random-string-here-and-rotate-regularly-XXXXXXXXXXXXXXXXXXXX
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# 渠道配置加密密钥 (base64 编码的 32 字节密钥，用于加密存储渠道凭证)
# 请使用 openssl rand -base64 32 生成自己的密钥；提交前留空
CHANNEL_ENCRYPTION_KEY=your_channel_encryption_key_base64_here

# MinIO Object Storage Configuration
# dev 环境使用 minioadmin（与 docker-compose 默认值一致），生产环境必须更换强密码
MINIO_ENDPOINT=graphiti-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_SECURE=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log
