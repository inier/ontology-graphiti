# Environment variables (contains sensitive data)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test databases
*.db
*.db-shm
*.db-wal
tests/data/*.db
tests/data/*.db-shm
tests/data/*.db-wal

# Runtime data (backend)
apps/api/data/
apps/api/reports/
*.tmp
*.temp
.specify/_installers

# OPA policy bundles (auto-generated at runtime by PolicyBundleManager)
# Each hot-update creates a timestamped bundle + rewrites current_bundle.json.
# These are build artifacts, not source — safe to regenerate on first run.
apps/api/odap/infra/opa/bundles/

# Speckit extensions cache (auto-generated by extension installer)
.specify/extensions/.cache/

# Orphan gitlink (.specify/extensions/superspec is registered as a gitlink
# in commit 2b751a7 but lacks a .gitmodules entry; local working-tree files
# are kept in sync by manual sync. Local files override the gitlink).
.specify/extensions/superspec/

# Frontend
node_modules/
apps/web/node_modules/
apps/web/dist/
apps/web/coverage/
apps/web/.env.local
*.tsbuildinfo

# Test coverage
coverage/
htmlcov/
.coverage
.pytest_cache/

# Neo4j data
neo4j_data/

# MinIO data
minio_data/

.galaxycode-core/

.galaxy/

.crush/

*.sqlite
*.sqlite3
.workbuddy/
*.bak

# Trae IDE - local skill installation cache + planning documents
# (保留 .trae/rules 版本控制；skills/ 是 IDE 本地缓存；documents/ 是
# 临时规划文档，不应纳入版本控制)
.trae/skills/
.trae/documents/
.superpowers/

# Qoder IDE - auto-generated repo wiki snapshot (与 docs/ 重复，不纳入版本控制)
.qoder/

# Local diagnostic and debugging scratch scripts
diag_*.py
debug_*.py

# Local temporary runtime artifacts (JSON bodies, PowerShell snippets, token dumps)
tmp_*
token.txt

# === 临时文件目录化治理（AGENTS.md 规则 13）===
# 根目录散落临时文件锁定（前导 / 锁定根目录，防止误跟踪）
# 注：*.log 和 *.db 已在上方全局忽略，此处显式锁定根目录，文档化意图
/app.log
/bootstep_dev.log
/sessions.db
# .env.docker 包含敏感密钥（OPENAI_API_KEY/JWT_SECRET 等），禁止跟踪
# （已被上方 .env.* 通配，此行显式文档化意图；如已被跟踪需 git rm --cached）
/.env.docker
# 测试运行产物（不应纳入版本控制）
/test-output/
# pytest --junitxml 报告与 vitest 输出
apps/api/tests/report_*.xml
vitest_*.json
vitest_*.txt
apps/web/vitest_*.json
# 提交信息 / git 状态快照草稿（应直接用 git 命令，不落盘）
/_commit_msg*.txt
/_git_status_full.txt
# 一次性诊断脚本与补丁草稿（规则 13：应归档到 scripts/archive/）
/_inspect_*.py
/*.patch
apps/api/_test_syntax.py
# 临时试验目录
/.scratch/
# 运行期在 CWD 落盘的数据库目录（规则 13：DATA_DIR 应指向 apps/api/data/）
/data/
# 根目录临时 i18n/抽取脚本（应归档到 scripts/archive/）
/convert-to-chinese-key.py
/update-en-ja-translations.py
/check-missing-keys.py
/create-missing-locales.py
/test_extract.py
# 各模块 temp/ 子目录（运行时产物，可随时清理）
# 注：git 的 ! 例外规则无法重新包含被通配符排除的文件，因此不在
# 根 .gitignore 中递归忽略 **/temp/。模块若需忽略 temp/，在模块
# .gitignore 中配置；若需将 temp/README.md 或 .gitkeep 骨架纳入版本
# 控制，使用 git add -f 强制添加（详见 AGENTS.md 规则 13）。
# 归档目录不忽略（scripts/archive/ 需跟踪）
!scripts/archive/

# 本地一次性分析/修复产物（不应入库）
/apps/web/.fix*.py
/apps/web/.rep*.mjs
/apps/web/.ana.mjs
/apps/web/.eslint-*.json
/apps/web/.tsc*.txt
/eslint-report*.json
/tsc-errors.txt

